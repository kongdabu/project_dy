# AI 공급자 설정 (openrouter 또는 gemini)
AI_PROVIDER=openrouter

# OpenRouter API Key 및 모델 (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3.7-flash

# (선택) Google AI Studio Gemini API Key (AI_PROVIDER=gemini 사용 시)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Supabase 프로젝트 설정
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key_here
SUPABASE_BUCKET=study-materials

# CORS 허용 도메인 (쉼표로 구분)
ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# 포털 접근 패스코드 (설정 시 로그인 화면 활성화, 미설정 시 인증 생략)
PORTAL_PASSCODE=change_this_to_your_secret_passcode
AUTH_SECRET=change_this_to_random_hex_string

